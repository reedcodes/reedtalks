{
	"name": "starwipe",
	"version": "0.2.0-alpha",
	"description": "a small little presentation slideshow built with 11ty and reveal.js",
	"author": "Reed Piernock",
	"license": "GPL-3.0-only",
	"type": "module",
	"devDependencies": {
		"@11ty/eleventy": "^3.0.0",
		"@11ty/eleventy-img": "^6.0.2",
		"eleventy-plugin-gen-favicons": "^1.1.3",
		"eleventy-plugin-metagen": "^1.8.3",
		"markdown-it": "^14.1.0",
		"markdown-it-attrs": "^4.3.1",
		"npm-run-all": "^4.1.5",
		"nps": "^5.10.0",
		"reveal.js": "^5.2.1",
		"sass": "^1.86.3"
	},
	"scripts": {
		"prepare": "nps prepare.init",
		"build:css": "nps css.build",
		"watch:css": "nps css.watch",
		"build:site": "nps site.build",
		"watch:site": "nps site.watch",
		"build": "npm-run-all build:*",
		"start": "npm-run-all --parallel watch:*"
	}
}
